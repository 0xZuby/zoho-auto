# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API (the Next.js dev server by default)
CORS_ORIGIN=http://localhost:3000

# Session cookie signing secret for auditor/admin logins. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# Local development/demo credentials. Accounts are seeded when their email
# does not already exist in the configured data directory.
SEED_ADMIN_EMAIL=admin@insidemaps.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_AUDITOR_EMAIL=auditor@insidemaps.com
SEED_AUDITOR_PASSWORD=Auditor123!

# Corporate email domain used when generating proposed Zoho addresses
CORPORATE_EMAIL_DOMAIN=gmail.com

# --- Zoho integration -------------------------------------------------------
# Leave ZOHO_MODE=simulated to run the full workflow without calling Zoho.
# Set ZOHO_MODE=live and fill in the OAuth values below to provision real accounts
# via the Zoho Directory / Zoho Mail Admin APIs.
ZOHO_MODE=simulated
ZOHO_DC=com
ZOHO_ORG_ID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# --- Outbound account-notification email -----------------------------------
# Leave MAIL_MODE=outbox to write notification emails to backend/data/outbox
# instead of sending them, which is useful for local development and demos.
MAIL_MODE=outbox
MAIL_FROM="IT Provisioning <it@insidemaps.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
